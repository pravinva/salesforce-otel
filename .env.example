# Copy to .env and fill values. Never commit .env.
# Or symlink: ln -s ~/.vibe/salesforce-otel/demo.env .env

# --- Databricks (Zerobus OTLP) ---
WORKSPACE_URL=fevm-ot-pdm-semi.cloud.databricks.com
WORKSPACE_ID=7474651137949483
REGION=us-east-1
CATALOG=ot_pdm_semi_catalog
SCHEMA=agentforce_otel
TABLE_PREFIX=agentforce
DATABRICKS_CLIENT_ID=<service-principal-application-id>
DATABRICKS_CLIENT_SECRET=<service-principal-oauth-secret>

# --- Salesforce Agentforce ---
SALESFORCE_INSTANCE_URL=https://orgfarm-91850b6147-dev-ed.develop.my.salesforce.com
SALESFORCE_API_VERSION=v66.0
# Preferred for long-running poller: External Client App (client credentials)
SALESFORCE_CLIENT_ID=
SALESFORCE_CLIENT_SECRET=
# Optional: pin a single session for testing
# SALESFORCE_SESSION_ID=

# Poller behaviour
POLL_INTERVAL=60
MAX_PASSES=1
DISCOVERY_WINDOW_DAYS=3
DISCOVERY_LIMIT=20
SESSION_IDLE_SECONDS=120
DRY_RUN=false

# Local OTel Collector receiver (poller posts Protobuf here)
OTEL_COLLECTOR_TRACES_URL=http://127.0.0.1:4318/v1/traces
